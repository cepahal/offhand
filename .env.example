# Hub
HUB_PORT=8787
# Bind address. Defaults to 127.0.0.1 (localhost only). Set 0.0.0.0 only on a trusted network.
HUB_BIND=127.0.0.1
CASEPACK_DIR=./casepacks
LOG_DIR=./logs
SNAPSHOT_DIR=./snapshots

# Gesture board (ESP32 + PAJ7620U2 over USB serial)
# GESTURE_PORT: "auto" (scan for an ESP32 USB bridge), "off", or an explicit port (COM5, /dev/ttyUSB0)
GESTURE_PORT=auto
GESTURE_BAUD=115200
GESTURE_DEBOUNCE_MS=250
# Heartbeat arrives every 2 s; after this long with no line the board is reported "lost"
GESTURE_HEARTBEAT_TIMEOUT_MS=5000

# Web (Vite dev server)
VIEWER_PORT=5173
