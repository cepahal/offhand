# Copy to .env (git-ignored) and edit there. Every variable is optional: an empty or
# commented-out value falls back to the default shown. Everything outside the hub,
# viewer and test pattern is off or mocked by default, and `pnpm dev` needs no credentials.
# Never put a patient's phone number in this file; recipients opt in by texting the keyword.
#
# Run modes are chosen by the script, not by this file:
#   pnpm dev        forces every module to mock (offline, no credentials), whatever is set below.
#   pnpm start:live forces AI_MODE=live and PHOTON_MODE=live and refuses to start, naming the
#                   setting, unless every live setting below is present (INTEG_SLICER=live and
#                   INTEG_CLINIC_INBOX=live included). It prints the active Photon transport.

# Hub
HUB_PORT=8787
# Bind address. Defaults to 127.0.0.1 (localhost only). Set 0.0.0.0 only on a trusted network.
HUB_BIND=127.0.0.1
CASEPACK_DIR=./casepacks
LOG_DIR=./logs
SNAPSHOT_DIR=./snapshots
# pino level: trace, debug, info, warn, error. Secrets and phone numbers are redacted at every level.
LOG_LEVEL=info

# Gesture board (ESP32 + PAJ7620U2 over USB serial)
# GESTURE_PORT: "auto" (scan for an ESP32 USB bridge), "off", or an explicit port (COM5, /dev/ttyUSB0)
GESTURE_PORT=auto
GESTURE_BAUD=115200
GESTURE_DEBOUNCE_MS=250
# Heartbeat arrives every 2 s; after this long with no line the board is reported "lost"
GESTURE_HEARTBEAT_TIMEOUT_MS=5000
# How often to look for the board again while it is missing
GESTURE_RESCAN_MS=3000

# Web (Vite dev server)
VIEWER_PORT=5173
# Voice input for the dental workstation. Leave unset to use Chrome's Web Speech API.
# When set, the page checks this local server before uploading audio and does not fall back to Chrome.
# Whisper.cpp: http://127.0.0.1:8080  (POST /inference). OpenAI-compatible: a server that answers GET /v1/models.
# WHISPER_URL=http://127.0.0.1:8080

# AI (voice, explain, claim check). Defaults: config/ai.json; personal overrides: config/ai.local.json.
# Keep "mock" for development. "live" calls Amazon Bedrock and refuses to start without the
# three AI_* ids below. AWS credentials come from the standard AWS credential chain
# (aws sso login / AWS_PROFILE), never from this file.
AI_MODE=mock
# AWS_REGION=us-east-2
# Converse model or inference profile for voice commands and explanations, e.g. us.amazon.nova-lite-v1:0
# AI_CONVERSE_MODEL_ID=
# Guardrail with the NeuroView Automated Reasoning policy (source: policies/neuroview/rulebook-source.md)
# AI_GUARDRAIL_ID=
# AI_GUARDRAIL_VERSION=

# Messaging (Photon / iMessage). Defaults: config/photon.json; overrides: config/photon.local.json.
# "mock" uses the simulated phone at /phone. "live" refuses to start without the project id and key.
# Nothing is ever sent unless the text is verified and the clinician confirms.
PHOTON_MODE=mock
# PHOTON_PROJECT_ID=
# PHOTON_API_KEY=
# sdk (default): one long-lived spectrum-ts connection inside the hub; no public URL needed.
# webhook: Spectrum POSTs to <PHOTON_PUBLIC_URL>/webhooks/photon; start:live prints the URL to register.
# Any other value makes start:live refuse to start.
# PHOTON_TRANSPORT=sdk
# The Spectrum line cards are sent from, E.164. Only its last 4 digits are ever printed.
# PHOTON_LINE=
# webhook transport only: public HTTPS origin, and the signing secret from Spectrum / Webhooks.
# PHOTON_PUBLIC_URL=https://example.ngrok.app
# PHOTON_WEBHOOK_SECRET=
# Optional customizedMiniApp() card; needs your own iMessage extension. All three or none.
# PHOTON_MINIAPP_APP_NAME=
# PHOTON_MINIAPP_TEAM_ID=
# PHOTON_MINIAPP_BUNDLE_ID=
# Keyword a patient texts to opt in (default HOVERSCAN)
# PHOTON_OPTIN_KEYWORD=HOVERSCAN
# Mock only: simulate the patient reading the message (default true)
# PHOTON_MOCK_READ=true

# Integrations: each is off | mock | live ("on" means mock). Defaults: config/integrations.json.
INTEG_LOGONLY=off
INTEG_OPENDENTAL=off
# INTEG_OPENDENTAL_URL=https://api.opendental.com/api/v1
# INTEG_OPENDENTAL_DEVELOPER_KEY=
# INTEG_OPENDENTAL_CUSTOMER_KEY=
# 3D Slicer WebServer. The URL must be 127.0.0.1 or localhost; anything else refuses to start.
INTEG_SLICER=off
# INTEG_SLICER_URL=http://localhost:2016
INTEG_ORTHANC=off
# INTEG_ORTHANC_URL=http://localhost:8042/dicom-web
# INTEG_ORTHANC_USERNAME=
# INTEG_ORTHANC_PASSWORD=
# NeuroView clinic-record stand-in: every vote as one JSON line, no phone number. Shown on /debug.
INTEG_CLINIC_INBOX=off
# INTEG_CLINIC_INBOX_FILE=data/clinic-inbox.jsonl
