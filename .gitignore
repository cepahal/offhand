node_modules/
dist/
.vite/
coverage/
*.log
logs/*.jsonl
snapshots/
.env
.env.*
!.env.example
# Personal config overrides (may hold keys or patient mappings)
config/*.local.json

# Python
__pycache__/
.venv/
.pytest_cache/
*.egg-info/

# Large / licensed data never goes in git (dataset licences forbid redistribution in several cases)
data/
data/gesture-samples/
casepacks/**/*.glb
casepacks/**/*.nii
casepacks/**/*.nii.gz
casepacks/**/*.dcm
# ISBI 2015 licence: no redistribution of the data or anything derived from it, so the whole
# NeuroView case (meshes, volumes, measured manifest) stays local. Rebuild: pnpm build:neuroview
casepacks/neuroview/
# ...except the generated TEST PATTERN pack, which is synthetic geometry (not anatomy)
!casepacks/test-pattern/**

# Arduino build output
firmware/**/build/
