{
  "name": "@offhand/hub",
  "version": "0.1.0",
  "private": true,
  "description": "Offhand hub: gesture board serial bridge, command bus (WebSocket), case pack server.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "pnpm --filter @hoverscan/contracts build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @hoverscan/contracts build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "replay": "tsx scripts/replay.ts",
    "gesture:monitor": "tsx scripts/gesture-monitor.ts",
    "record:gestures": "tsx scripts/record-gestures.ts",
    "start:live": "tsx src/server.ts",
    "test:failclosed": "tsx scripts/fail-closed-gate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1166.0",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@hoverscan/contracts": "workspace:*",
    "@spectrum-ts/core": "12.16.0",
    "@spectrum-ts/imessage": "12.16.0",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "serialport": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
