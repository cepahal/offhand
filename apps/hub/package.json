{
  "name": "@offhand/hub",
  "version": "0.1.0",
  "private": true,
  "description": "Offhand hub: gesture board serial bridge, command bus (WebSocket), case pack server.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "replay": "tsx scripts/replay.ts",
    "gesture:monitor": "tsx scripts/gesture-monitor.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@offhand/contracts": "workspace:*",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
