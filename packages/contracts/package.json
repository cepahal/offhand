{
  "name": "@hoverscan/contracts",
  "version": "1.2.0",
  "private": true,
  "description": "Shared message/data contracts (Zod schemas + types + generated JSON Schema).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": ["dist", "schema"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "schema:check": "tsx scripts/gen-schema.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@types/node": "^24.0.0"
  }
}
