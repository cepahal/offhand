{
  "$id": "hoverscan/CasePackManifest.json",
  "title": "CasePackManifest",
  "x-contracts-version": "1.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1,
      "description": "Manifest schema version."
    },
    "app": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "App id, e.g. \"chairside\", \"kneeview\", \"neuroview\", \"jawline\", or \"test-pattern\"."
    },
    "caseId": {
      "type": "string",
      "pattern": "^[\\w-]+$",
      "description": "Case id (folder name)."
    },
    "title": {
      "type": "string",
      "description": "Display title."
    },
    "source": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "description": "Dataset name."
        },
        "url": {
          "type": "string",
          "description": "Dataset landing page."
        },
        "license": {
          "type": "string",
          "description": "Dataset licence (shown on screen)."
        },
        "citation": {
          "type": "string",
          "description": "Required citation."
        },
        "subjectId": {
          "type": "string",
          "description": "Subject/case id inside the dataset."
        }
      },
      "required": [
        "dataset",
        "url",
        "license",
        "citation",
        "subjectId"
      ],
      "description": "Provenance, shown on screen."
    },
    "deidentified": {
      "type": "boolean",
      "const": true,
      "description": "Must be true; only de-identified public data."
    },
    "coordinateSystem": {
      "type": "string",
      "const": "RAS",
      "description": "All coordinates are RAS."
    },
    "units": {
      "type": "string",
      "const": "mm",
      "description": "All lengths are millimetres."
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Layer id, unique within the case."
          },
          "label": {
            "type": "string",
            "description": "Display label (from the dataset label map)."
          },
          "file": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*\\.\\.)[\\w./-]+$",
            "description": "GLB file, relative to the case folder."
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Display colour, #rrggbb."
          },
          "defaultOpacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Initial opacity."
          },
          "peelOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "0 = outermost (peeled first)."
          },
          "kind": {
            "type": "string",
            "const": "surface",
            "description": "Layer kind. Only surfaces for now."
          },
          "timepointId": {
            "description": "Additive 1.2.0. Timepoint this layer belongs to; shown only at that timepoint. Absent = all.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "file",
          "color",
          "defaultOpacity",
          "peelOrder",
          "kind"
        ],
        "description": "One surface mesh layer."
      },
      "description": "Surface layers."
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Volume id."
          },
          "file": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*\\.\\.)[\\w./-]+$",
            "description": "NIfTI file (RAS), relative to the case folder."
          },
          "modality": {
            "type": "string",
            "description": "e.g. \"MR\", \"CT\", \"CBCT\"."
          },
          "sequence": {
            "type": "string",
            "description": "e.g. \"qDESS\", \"FLAIR\", \"T1\"."
          },
          "timepointId": {
            "description": "Timepoint this volume belongs to.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "file",
          "modality",
          "sequence"
        ],
        "description": "A volume for the slice panel."
      },
      "description": "Volumes for the slice panel (may be empty)."
    },
    "timepoints": {
      "description": "Timepoints (longitudinal cases).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Timepoint id."
          },
          "label": {
            "type": "string",
            "description": "Display label, e.g. \"Visit 2\"."
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Sort order."
          }
        },
        "required": [
          "id",
          "label",
          "order"
        ],
        "description": "A timepoint (longitudinal studies)."
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Finding id."
          },
          "label": {
            "type": "string",
            "description": "Display label, taken from the dataset (never invented)."
          },
          "layerId": {
            "description": "Layer the finding belongs to.",
            "type": "string"
          },
          "center": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3,
            "description": "Centre, RAS mm."
          },
          "radiusMm": {
            "type": "number",
            "minimum": 0,
            "description": "Approximate radius, mm."
          },
          "provenance": {
            "type": "string",
            "enum": [
              "dataset_label",
              "dataset_report",
              "measured"
            ],
            "description": "Where it came from: dataset label mask, dataset report text, or measured by the pipeline."
          },
          "reportExcerpt": {
            "description": "Verbatim excerpt from the dataset report, if any.",
            "type": "string"
          },
          "timepointId": {
            "description": "Timepoint the finding belongs to.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "center",
          "radiusMm",
          "provenance"
        ],
        "description": "A finding taken from the dataset (labels/report) or measured from it."
      },
      "description": "Findings (may be empty)."
    },
    "report": {
      "description": "Dataset report, if the dataset has one.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Report text from the dataset."
        },
        "provenance": {
          "type": "string",
          "enum": [
            "dataset_report",
            "measured"
          ],
          "description": "Origin of the report text."
        }
      },
      "required": [
        "text",
        "provenance"
      ]
    },
    "share": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "description": "Share template id."
        },
        "pollOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "description": "Poll option."
          },
          "description": "Poll options offered to the patient."
        }
      },
      "required": [
        "templateId",
        "pollOptions"
      ],
      "description": "Share-to-patient settings."
    },
    "policyId": {
      "type": "string",
      "description": "Rulebook/policy id used to check text for this case."
    }
  },
  "required": [
    "schema",
    "app",
    "caseId",
    "title",
    "source",
    "deidentified",
    "coordinateSystem",
    "units",
    "layers",
    "volumes",
    "findings",
    "share",
    "policyId"
  ],
  "description": "manifest.json at the root of every case pack."
}
