{
  "$id": "offhand/GestureEvent.json",
  "title": "GestureEvent",
  "x-contracts-version": "1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "g",
          "description": "Discrete gesture."
        },
        "g": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "left",
            "right",
            "forward",
            "backward",
            "cw",
            "ccw",
            "wave"
          ],
          "description": "Gesture name as reported by the board (already orientation-corrected by firmware)."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Per-boot sequence number, increments per event."
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Board uptime in milliseconds (millis())."
        }
      },
      "required": [
        "t",
        "g",
        "seq",
        "ms"
      ],
      "description": "A discrete gesture detected by the PAJ7620U2."
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "h",
          "description": "Hover sample."
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Normalised hand X over the sensor, 0..1."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Normalised hand Y over the sensor, 0..1."
        },
        "z": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Normalised proximity, 0 = far/none, 1 = very close."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Per-boot sequence number, increments per event."
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Board uptime in milliseconds (millis())."
        }
      },
      "required": [
        "t",
        "x",
        "y",
        "z",
        "seq",
        "ms"
      ],
      "description": "Continuous hover sample, sent only while an object is in view."
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "hb",
          "description": "Heartbeat, every 2 s."
        },
        "fw": {
          "type": "string",
          "description": "Firmware version string."
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Board uptime in milliseconds (millis())."
        },
        "paj": {
          "description": "Optional (additive): sensor health as seen by the firmware.",
          "type": "string",
          "enum": [
            "ok",
            "missing",
            "lost"
          ]
        }
      },
      "required": [
        "t",
        "fw",
        "ms"
      ],
      "description": "Board heartbeat. Absence for > timeout means the link is lost."
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "err",
          "description": "Error report."
        },
        "msg": {
          "type": "string",
          "description": "Human-readable error message."
        }
      },
      "required": [
        "t",
        "msg"
      ],
      "description": "Error reported by the board firmware."
    }
  ],
  "description": "Line-delimited JSON event emitted by the ESP32 gesture board."
}
