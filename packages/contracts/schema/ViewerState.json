{
  "$id": "offhand/ViewerState.json",
  "title": "ViewerState",
  "x-contracts-version": "1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "app": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "App id, e.g. \"chairside\", \"kneeview\", \"neuroview\", \"jawline\", or \"test-pattern\"."
        },
        {
          "type": "null"
        }
      ],
      "description": "Loaded app, or null when nothing is loaded."
    },
    "caseId": {
      "description": "Loaded case id, or null.",
      "type": [
        "string",
        "null"
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Camera position (viewer world coordinates)."
        },
        "target": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Orbit target (viewer world coordinates)."
        },
        "up": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Camera up vector."
        }
      },
      "required": [
        "position",
        "target",
        "up"
      ],
      "description": "Camera pose."
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Layer id from the manifest."
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Current opacity."
          },
          "visible": {
            "type": "boolean",
            "description": "Current visibility."
          }
        },
        "required": [
          "id",
          "opacity",
          "visible"
        ],
        "description": "Runtime state of one surface layer."
      },
      "description": "Per-layer runtime state."
    },
    "slice": {
      "type": "object",
      "properties": {
        "plane": {
          "type": "string",
          "enum": [
            "axial",
            "coronal",
            "sagittal"
          ],
          "description": "Slice plane."
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Slice index."
        }
      },
      "required": [
        "plane",
        "index"
      ],
      "description": "Current 2D slice."
    },
    "timepoint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Active timepoint index."
    },
    "scrub": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Current scrub value."
    },
    "mode": {
      "type": "string",
      "enum": [
        "orbit",
        "scrub"
      ],
      "description": "orbit = discrete gestures turn/zoom/peel; scrub = hand height drives the app scrub axis."
    },
    "focusedFindingId": {
      "description": "Focused finding id, or null.",
      "type": [
        "string",
        "null"
      ]
    },
    "bookmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Bookmark id."
          },
          "label": {
            "type": "string",
            "description": "Bookmark label."
          },
          "snapshotUrl": {
            "description": "URL of the PNG snapshot served by the hub.",
            "type": "string"
          },
          "state": {
            "type": "object",
            "properties": {
              "app": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$",
                    "description": "App id, e.g. \"chairside\", \"kneeview\", \"neuroview\", \"jawline\", or \"test-pattern\"."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Loaded app, or null when nothing is loaded."
              },
              "caseId": {
                "description": "Loaded case id, or null.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "camera": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "Camera position (viewer world coordinates)."
                  },
                  "target": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "Orbit target (viewer world coordinates)."
                  },
                  "up": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "Camera up vector."
                  }
                },
                "required": [
                  "position",
                  "target",
                  "up"
                ],
                "description": "Camera pose."
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Layer id from the manifest."
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Current opacity."
                    },
                    "visible": {
                      "type": "boolean",
                      "description": "Current visibility."
                    }
                  },
                  "required": [
                    "id",
                    "opacity",
                    "visible"
                  ],
                  "description": "Runtime state of one surface layer."
                },
                "description": "Per-layer runtime state."
              },
              "slice": {
                "type": "object",
                "properties": {
                  "plane": {
                    "type": "string",
                    "enum": [
                      "axial",
                      "coronal",
                      "sagittal"
                    ],
                    "description": "Slice plane."
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Slice index."
                  }
                },
                "required": [
                  "plane",
                  "index"
                ],
                "description": "Current 2D slice."
              },
              "timepoint": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Active timepoint index."
              },
              "scrub": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Current scrub value."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "orbit",
                  "scrub"
                ],
                "description": "orbit = discrete gestures turn/zoom/peel; scrub = hand height drives the app scrub axis."
              },
              "focusedFindingId": {
                "description": "Focused finding id, or null.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "app",
              "caseId",
              "camera",
              "layers",
              "slice",
              "timepoint",
              "scrub",
              "mode",
              "focusedFindingId"
            ],
            "description": "A view without bookmarks/pending (stored inside bookmarks)."
          }
        },
        "required": [
          "id",
          "label",
          "state"
        ],
        "description": "A saved view."
      },
      "description": "Saved views."
    },
    "pending": {
      "type": "object",
      "properties": {
        "confirmFor": {
          "description": "Action awaiting confirm/cancel.",
          "type": "string"
        }
      },
      "description": "Pending confirmation, if any."
    }
  },
  "required": [
    "app",
    "caseId",
    "camera",
    "layers",
    "slice",
    "timepoint",
    "scrub",
    "mode",
    "focusedFindingId",
    "bookmarks",
    "pending"
  ],
  "description": "Viewer state, published by the viewer at most 10 Hz; the hub caches the latest."
}
